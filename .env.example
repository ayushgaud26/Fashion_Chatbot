# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini          # auto | openai | gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# For OpenAI instead: set LLM_PROVIDER=openai and provide OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# auto = try sentence-transformers, fall back to an offline hashing embedder (clearly labelled in the UI)
# sentence-transformers = strict (error if the model cannot load) | hashing = offline test embedder
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATASET_PATH=data/myntra/myntra-dataset-sample-main/Myntra products .csv
CHROMA_DIR=chroma_db
COLLECTION_NAME=fashion_products_myntra
RETAIL_CATALOG_PATH=data/retail_products.json
BATCH_SIZE=256
DEV_SUBSET_SIZE=0          # 0 = use every record in the Arrow file
MAX_RESULTS=50             # cap for "show all matching" queries
SEMANTIC_TOP_K=10
SEMANTIC_MAX_DISTANCE=0.8  # cosine distance cut-off for purely semantic results
